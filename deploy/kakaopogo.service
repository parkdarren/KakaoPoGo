[Unit]
Description=KakaoPoGo FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/kakaopogo
Environment=OWNER_SETUP_CODE=change-me
ExecStart=/opt/kakaopogo/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
